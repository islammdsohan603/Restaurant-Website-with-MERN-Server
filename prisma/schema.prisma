// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  name     String
  username String   @unique
  email    String   @unique
  password String
  roll     UserRoll @default(User)

  orders Order[]

  @@map("users")
}

enum UserRoll {
  User
  Admin
  Manager
}

model Product {
  id          String  @id @default(uuid())
  title       String
  description String?
  price       Int
  stock       Int

  @@map("products")
}

model Order {
  id     String @id @default(uuid())
  userId String

  quantity Int

  user User @relation(fields: [userId], references: [id])

  @@map("orders")
}
